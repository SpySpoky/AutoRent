<Window x:Class="AutoRent.Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoRent"
        mc:Ignorable="d"
        Title="Менеджер" MaxHeight="650" MinHeight="650" MaxWidth="1000" MinWidth="1000" Height="650" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="327*"/>
            <ColumnDefinition Width="665*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="MainGrid" Margin="30" Grid.ColumnSpan="2">
            <TabControl Margin="10,82,10,0">
                <TabItem Header="Продажи" Margin="-2,-3,-61,0" >
                    <Grid >
                        <DataGrid AutoGenerateColumns="False" x:Name="OrdersTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="0,128,0,10" IsReadOnly="True" FontSize="14" SelectionChanged="OrdersTable_SelectionChanged" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер заказа" Binding="{Binding id_Sales}"/>
                                <DataGridTextColumn Header="Работник" Binding="{Binding Workers}"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding Clients}"/>
                                <DataGridTextColumn Header="Артикул мототехники" Binding="{Binding Moto}"/>
                                <DataGridTextColumn Header="Количество(шт)" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="Цена(руб.коп)" Binding="{Binding Cost}"/>
                                <DataGridTextColumn Header="Тип оплаты" Binding="{Binding Payment_type}"/>
                                <DataGridTextColumn Header="Итоговая цена(руб.коп)" Binding="{Binding Final_price}"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date,StringFormat='dd.MM.yyyy'}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Width="926"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="188*"/>
                                <ColumnDefinition Width="729*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddOrders" Content="Добавить" HorizontalAlignment="Left" Margin="255,89,0,0" VerticalAlignment="Top" Width="120" Click="AddOrders_Click" Grid.Column="2" Height="29"/>
                            <Button x:Name="UpdateOrders" Content="Обновить" HorizontalAlignment="Left" Margin="390,89,0,0" VerticalAlignment="Top" Width="120" Click="UpdateOrders_Click" Grid.Column="2" Height="29" />
                            <Label x:Name="LBWorkersOrders" Content="Работник" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,11,0,0" Grid.Column="1" FontWeight="Bold" />
                            <ComboBox x:Name="CBWorkersOrders" Width="121" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,36,0,0" ItemsSource="{Binding}" Grid.Column="1" Height="25"/>
                            <Label x:Name="LBCarsOrders" Content="Клиент" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,73,0,0" Grid.Column="1" FontWeight="Bold" />
                            <ComboBox x:Name="CBClientsOrders" HorizontalAlignment="Left" VerticalAlignment="Top" Width="121" ItemsSource="{Binding}" Margin="1,93,0,0" Grid.Column="1" Height="25" />
                            <ComboBox x:Name="CBArticle" HorizontalAlignment="Left" VerticalAlignment="Top" Width="131" ItemsSource="{Binding}"  Margin="148,36,0,0" Grid.Column="1" Height="25" Grid.ColumnSpan="2" />
                            <Label  Content="Артикул мототехники" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="148,11,0,0" Grid.Column="1" Grid.ColumnSpan="2" FontWeight="Bold" />
                            <Label  Content="Количество(шт)" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="148,73,0,0" Grid.Column="1" Width="131" Grid.ColumnSpan="2" FontWeight="Bold" />
                            <TextBox x:Name="TBQuantity" Width="119" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,93,0,0" Grid.Column="1" Height="25" Grid.ColumnSpan="2" TextChanged="TBQuantity_TextChanged" />
                            <Label  Content="Цена(руб.коп)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,11,0,0" Grid.Column="2" Height="24" Width="119" FontWeight="Bold" />
                            <TextBox  x:Name="TBPriceOrders" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="111,36,0,0" Grid.Column="2" Height="25" Width="119" TextChanged="TBQuantity_TextChanged" PreviewTextInput="TBPriceOrders_PreviewTextInput"/>
                            <ComboBox x:Name="CBPayment_type" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding}" Width="119" Margin="114,93,0,0" Grid.Column="2" Height="25"/>
                            <Label  Content="Тип оплаты" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,73,0,0" Grid.Column="2" Width="119" FontWeight="Bold" />
                            <Label x:Name="LBDateOrders"  HorizontalAlignment="Left" VerticalAlignment="Top" Content="Дата" Margin="255,11,0,0" Grid.Column="2" FontWeight="Bold" />
                            <DatePicker x:Name="Date" Height="28" Grid.Column="2" Margin="255,33,364,67" RenderTransformOrigin="0.619,0.519" SelectedDateFormat="Short"/>
                            <Button Content="Чек" Grid.Column="2" HorizontalAlignment="Left" Margin="528,89,0,0" VerticalAlignment="Top" Width="120" Height="29" Click="Button_Click_1"/>
                            <TextBox  HorizontalAlignment="Left" Height="28" Margin="378,33,0,0" TextWrapping="Wrap" x:Name="TBFinal_cost" VerticalAlignment="Top" Width="149" Grid.Column="2" PreviewTextInput="TBFinal_cost_TextChanged"/>
                            <Label Content="Итоговая цена(руб.коп)" Grid.Column="2" HorizontalAlignment="Left" Margin="378,11,0,0" VerticalAlignment="Top" Width="149" FontWeight="Bold"/>
                            <TextBox HorizontalAlignment="Left" Height="25" Margin="547,36,0,0" TextWrapping="Wrap" x:Name="PoiskOrders" VerticalAlignment="Top" Width="120" Grid.Column="2" TextChanged="PoiskOrders_TextChanged"/>
                            <Label Content="Поиск" Grid.Column="2" HorizontalAlignment="Left" Margin="547,11,0,0" VerticalAlignment="Top" Width="120" FontWeight="Bold"/>
                            <TextBox Visibility="Hidden" HorizontalAlignment="Left" Height="20" Margin="534,64,0,0" TextWrapping="Wrap" x:Name="Id" VerticalAlignment="Top" Width="120" Grid.Column="2"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Мототехника" Margin="60,-3,-79,0" >
                    <Grid >
                        <DataGrid AutoGenerateColumns="False" x:Name="MotoTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="10,128,10,10" IsReadOnly="True" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Артикул" Binding="{Binding Article_moto}"/>
                                <DataGridTextColumn Header="Мототехника" Binding="{Binding Name_moto}"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Type_moto}"/>
                                <DataGridTextColumn Header="Модель" Binding="{Binding Model}"/>
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}"/>
                                <DataGridTextColumn Header="Цвет" Binding="{Binding Color}"/>
                                <DataGridTextColumn Header="Количество(шт)" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="Цена(руб.коп)" Binding="{Binding Cost}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Width="926"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="188*"/>
                                <ColumnDefinition Width="729*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Poisk" HorizontalAlignment="Left" Height="23" Margin="1,52,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.Column="1" TextChanged="Poisk_TextChanged"/>
                        </Grid>
                    </Grid>
                </TabItem>


                <TabItem  Header="Клиенты" Margin="79,-3,-133,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="419*"/>
                            <ColumnDefinition Width="44*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="LBSurname" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Фамилия" Margin="1,75,0,0" Width="129" RenderTransformOrigin="0.5,0.5" FontWeight="Bold"/>
                        <Label x:Name="LBNameClients" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Имя" Margin="147,15,0,0" Width="129" RenderTransformOrigin="0.504,0.5" FontWeight="Bold"/>
                        <Label x:Name="LBMiddlename" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Отчество" Margin="147,75,0,0" Width="129" RenderTransformOrigin="0.5,0.5" FontWeight="Bold"/>
                        <Label x:Name="LBPhone" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Телефон" Margin="1,15,0,0" Width="129" RenderTransformOrigin="0.5,0.5" FontWeight="Bold"/>
                        <Label x:Name="LBEmail" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Почта" Margin="292,15,0,0" Width="129" RenderTransformOrigin="0.5,0.5" FontWeight="Bold"/>
                        <TextBox x:Name="TBSurname"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Margin="0,101,0,0" Height="25" />
                        <TextBox x:Name="TBNameClients"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Margin="146,41,0,0" Height="25" />
                        <TextBox x:Name="TBMiddlename"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Margin="146,101,0,0" Height="25" />
                        <TextBox x:Name="TBPhone"  MaxLength="16" HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Margin="0,41,0,0" Height="25" PreviewTextInput="TBPhone_PreviewTextInput" KeyDown="TBPhone_KeyDown" />
                        <TextBox x:Name="TBEmail"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Margin="292,41,0,0" Height="25" />
                        <Label x:Name="LBStatusClients" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Статус" Margin="441,15,0,0" Width="129" RenderTransformOrigin="0.5,0.5" FontWeight="Bold"/>
                        <Label x:Name="LBGenderClients" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Пол" Margin="292,75,0,0" Width="129" RenderTransformOrigin="0.5,0.5" FontWeight="Bold"/>
                        <ComboBox x:Name="CBGenderClients" HorizontalAlignment="Left" VerticalAlignment="Top" Width="131" Margin="292,101,0,0" Height="25"/>
                        <ComboBox x:Name="CBStatusClients" HorizontalAlignment="Left" VerticalAlignment="Top" Width="131" Margin="441,41,0,0" Height="25"/>
                        <Button x:Name="AddClients" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Добавить" Margin="450,97,0,0" Click="AddClients_Click" Width="120" Height="29" />
                        <Button x:Name="UpdateClients" Content="Обновить" HorizontalAlignment="Left" Margin="592,97,0,0" VerticalAlignment="Top" Width="120" Click="UpdateClients_Click" Height="29" />
                        <Button x:Name="DeleteClients" Content="Удалить" HorizontalAlignment="Left" Margin="735,97,0,0" VerticalAlignment="Top" Width="120" Click="DeleteClients_Click" Height="29" Grid.ColumnSpan="2"/>
                        <DataGrid AutoGenerateColumns="False" x:Name="ClientsTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="10,154,10,10" IsReadOnly="True" SelectedCellsChanged="ClientsTable_SelectedCellsChanged" Grid.ColumnSpan="2" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone_number}"/>
                                <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Отчество" Binding="{Binding Lastname}"/>
                                <DataGridTextColumn Header="Почта" Binding="{Binding Email}"/>
                                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Отчет по продажам" Margin="132,-3,-192,0" >
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="301*"/>
                            <ColumnDefinition Width="605*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="OtchetTable" AutoGenerateColumns="False" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="10,133,10,10" IsReadOnly="True" Grid.ColumnSpan="2" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер заказа" Binding="{Binding id_Sales}"/>
                                <DataGridTextColumn Header="Работник" Binding="{Binding Workers}"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding Clients}"/>
                                <DataGridTextColumn Header="Артикул мототехники" Binding="{Binding Moto}"/>
                                <DataGridTextColumn Header="Количество(шт)" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="Цена(руб.коп)" Binding="{Binding Cost}"/>
                                <DataGridTextColumn Header="Тип оплаты" Binding="{Binding Payment_type}"/>
                                <DataGridTextColumn Header="Итоговая цена(руб.коп)" Binding="{Binding Final_price}"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date,StringFormat='dd.MM.yyyy'}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Width="926" Grid.ColumnSpan="2" Margin="0,0,-20,0"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="188*"/>
                                <ColumnDefinition Width="729*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="Date1" Height="28" Grid.Column="1" Margin="177,33,630,67" RenderTransformOrigin="0.619,0.519" SelectedDateFormat="Short" Grid.ColumnSpan="2"/>
                            <DatePicker x:Name="Date2" Height="28" Grid.Column="1" Margin="1,33,77,67" RenderTransformOrigin="0.619,0.519" SelectedDateFormat="Short"/>
                            <Button x:Name="Otchet" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Сделать отчет" Margin="75,89,0,0" Click="Otchet_Click" Width="147" Height="29" Grid.Column="1" Grid.ColumnSpan="2" />
                            <Label Content="С какого дня" Grid.Column="1" HorizontalAlignment="Left" Margin="0,4,0,0" VerticalAlignment="Top" Width="111" FontWeight="Bold"/>
                            <Label Content="По какой день" Grid.Column="1" HorizontalAlignment="Left" Margin="177,4,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="110" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
            <Label Content="Менеджер" HorizontalAlignment="Center" Margin="349,10,306,0" VerticalAlignment="Top" Width="277" FontSize="30" Foreground="#FF0F0101" FontWeight="Bold"/>
            <Image Margin="-17,-58,749,477" Source="Dooble_briliant-removebg-preview.png" Stretch="Fill"/>
        </Grid>
        <Button Content="Выход" HorizontalAlignment="Left" Margin="54,584,0,0" VerticalAlignment="Top" Width="122" Height="25" Click="Button_Click"/>
    </Grid>
</Window>
