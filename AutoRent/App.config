<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Local MySQL/MariaDB (XAMPP default: root with empty password). Change if needed. -->
        <add name="mototex" connectionString="server=localhost;port=3306;database=mototex;username=root;password=;" providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>