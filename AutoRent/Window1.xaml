<Window x:Class="AutoRent.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoRent"
        xmlns:dvc="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"       
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="Директор" MaxHeight="650" MinHeight="650" MaxWidth="1000" MinWidth="650" Height="650" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="327*"/>
            <ColumnDefinition Width="665*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="MainGrid" Margin="30" Grid.ColumnSpan="2">
            <TabControl Margin="10,82,10,0">
                <TabItem Header="Продажи" Margin="-2,-3,-61,0" >
                    <Grid >
                        <DataGrid AutoGenerateColumns="False" x:Name="OrdersTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="0,196,0,10" IsReadOnly="True" FontSize="14" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер заказа" Binding="{Binding id_Sales}"/>
                                <DataGridTextColumn Header="Работник" Binding="{Binding Workers}"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding Clients}"/>
                                <DataGridTextColumn Header="Артикул мототехники" Binding="{Binding Moto}"/>
                                <DataGridTextColumn Header="Количество(шт)" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="Цена(руб.коп)" Binding="{Binding Cost}"/>
                                <DataGridTextColumn Header="Тип оплаты" Binding="{Binding Payment_type}"/>
                                <DataGridTextColumn Header="Итоговая цена(руб.коп)" Binding="{Binding Final_price}"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date,StringFormat='dd.MM.yyyy'}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Height="191" HorizontalAlignment="Left" VerticalAlignment="Top" Width="926" Margin="0,0,-20,0"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="188*"/>
                                <ColumnDefinition Width="729*"/>
                            </Grid.ColumnDefinitions>
                            <WindowsFormsHost Margin="10,10,628,44" Grid.Column="1" Background="Yellow" Grid.ColumnSpan="2">
                                <dvc:Chart x:Name="Stata"/>
                            </WindowsFormsHost>
                            <DatePicker x:Name="Date2" Height="28" Grid.Column="2" Margin="330,51,289,112" RenderTransformOrigin="0.619,0.519" SelectedDateFormat="Short"/>
                            <DatePicker x:Name="Date1" Height="28" Grid.Column="2" Margin="164,51,455,112" RenderTransformOrigin="0.619,0.519" SelectedDateFormat="Short"/>
                            <Button Content="Статистика" HorizontalAlignment="Left" Margin="252,97,0,0" VerticalAlignment="Top" Width="120" Height="29" Click="Button_Click_1" Grid.Column="2"/>
                            <Label Content="С какого дня" HorizontalAlignment="Left" Margin="164,22,0,0" VerticalAlignment="Top" Grid.Column="2" Width="110"/>
                            <Label Content="По какой день" HorizontalAlignment="Left" Margin="330,22,0,0" VerticalAlignment="Top" Grid.Column="2" Width="110"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Мототехника" Margin="60,-3,-79,0" >
                    <Grid >
                        <DataGrid AutoGenerateColumns="False" x:Name="MotoTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="10,128,10,10" IsReadOnly="True" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Артикул" Binding="{Binding Article_moto}"/>
                                <DataGridTextColumn Header="Мототехника" Binding="{Binding Name_moto}"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Type_moto}"/>
                                <DataGridTextColumn Header="Модель" Binding="{Binding Model}"/>
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}"/>
                                <DataGridTextColumn Header="Цвет" Binding="{Binding Color}"/>
                                <DataGridTextColumn Header="Количество(шт)" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="Цена(руб.коп)" Binding="{Binding Cost}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Width="926"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="188*"/>
                                <ColumnDefinition Width="729*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem  Header="Работники" Margin="190,-3,-234,0">
                    <Grid>
                        <DataGrid AutoGenerateColumns="False"  x:Name="WorkersTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="10,128,10,10" IsReadOnly="True" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}"/>
                                <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Отчество" Binding="{Binding Lastname}"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role}"/>
                                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem  Header="Клиенты" Margin="6,-3,-60,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="419*"/>
                            <ColumnDefinition Width="44*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid AutoGenerateColumns="False" x:Name="ClientsTable" ItemsSource="{Binding}" Background="#FFFEFFE2" Margin="10,128,10,10" IsReadOnly="True" Grid.ColumnSpan="2" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone_number}"/>
                                <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Отчество" Binding="{Binding Lastname}"/>
                                <DataGridTextColumn Header="Почта" Binding="{Binding Email}"/>
                                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
            <Label Content="Директор" HorizontalAlignment="Center" Margin="349,10,306,0" VerticalAlignment="Top" Width="277" FontSize="30" Foreground="#FF0F0101" FontWeight="Bold"/>
            <Image Margin="-17,-58,749,477" Source="Dooble_briliant-removebg-preview.png" Stretch="Fill"/>
        </Grid>
        <Button Content="Выход" HorizontalAlignment="Left" Margin="54,584,0,0" VerticalAlignment="Top" Width="122" Height="25" Click="Button_Click"/>
    </Grid>
</Window>
