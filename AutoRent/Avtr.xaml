<Window x:Class="AutoRent.Avtr"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoRent"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Авторизация" Height="470" Width="650" MinWidth="650" MinHeight="470" MaxWidth="650" MaxHeight="470">
    <Grid>
        <Border  Height="400" Width="600" Margin="15" Background="White" VerticalAlignment="Center" Padding="30" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="LightGray" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel Height="339" VerticalAlignment="Top" Margin="-5,21,5,-20">
                <Grid Margin="0 0 0 0" Height="165">
                    <Label HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Margin="0,131,0,0" Content="Заполните поля" />
                    <Label x:Name="CaptchaText" Content="" Width="89" Height="35"  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="429,63,22,0"  FontSize="12"  Visibility="Visible" />
                    <TextBox x:Name="CaptchaTB" Width="89" Height="35" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="429,91,22,0"  FontSize="12" Visibility="Visible"/>
                    <Button x:Name="RepeatCaptcha" Width="138" Height="32" Content="Обновить" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="402,131,0,0"  FontSize="15" Click="RepeatCaptcha_Click" Visibility="Visible" />
                    <Image  x:Name="CaptchaBG"  Width="90" Height="35"  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="388,60,62,0" Visibility="Visible"  Stretch="Fill"/>
                    <TextBlock Text="Авторизация" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Margin="177,63,170,62"/>
                </Grid>
                <TextBox x:Name="TextBoxLogin"  materialDesign:HintAssist.Hint="Введите логин" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                <PasswordBox x:Name="TextBoxPassword"  materialDesign:HintAssist.Hint="Введите пароль" ToolTip="System.Windows.Controls.ToolTip" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>
                <CheckBox Content="Показать пароль" x:Name="checkBox1" Checked="CheckBox1_Checked"/>
                <Button Content="Войти" Margin="0,0" Click="Button_Click" Height="30"/>
            </StackPanel>
        </Border>
        <Image Margin="35,20,443,279" Source="Dooble_briliant.png" Stretch="Fill" RenderTransformOrigin="0.507,0.407"/>
    </Grid>
</Window>
